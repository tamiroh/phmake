{
    "name": "tamiroh/phmake",
    "description": "Re-implementation of GNU Make written in PHP.",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Tamiroh\\Phmake\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tamiroh\\Phmake\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "tamiroh",
            "email": "tamiroh71@gmail.com"
        }
    ],
    "require-dev": {
        "phpstan/phpstan": "^2.2.14",
        "phpunit/phpunit": "^13.3.4",
        "carthage-software/mago": "^1.49.0",
        "phpstan/phpstan-strict-rules": "^2.0.12"
    },
    "config": {
        "allow-plugins": {
            "carthage-software/mago": true
        }
    },
    "require": {
        "symfony/process": "^8.1.7"
    }
}
